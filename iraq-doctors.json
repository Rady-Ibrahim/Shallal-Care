{
  "info": {
    "name": "Shallal Care — Patient API (legacy)",
    "description": "endpoints تطبيق المريض (ميراث iraq-doctors).\n\n**قبل الاختبار:**\n```bash\nphp artisan migrate\nphp artisan db:seed\n```\n\n**حساب تجريبي:**\n- هاتف: `07708888000`\n- كلمة المرور: `password123`\n\nبعد Login يُحفظ `{{token}}` تلقائياً.\nشغّل **Login (Patient)** أولاً ثم باقي الطلبات.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "doctor_id", "value": "4", "type": "string", "description": "يُحدَّث من Search Doctors أو من مخرجات db:seed" },
    { "key": "schedule_id", "value": "2", "type": "string" },
    { "key": "branch_id", "value": "2", "type": "string" },
    { "key": "appointment_id", "value": "3", "type": "string", "description": "موعد مكتمل — للسجل والتقييم" }
  ],
  "item": [
    {
      "name": "🚀 البداية",
      "item": [
        {
          "name": "Login (Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    pm.test('Token saved', () => pm.expect(json.data.token).to.be.a('string'));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"07708888000\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "مريض تجريبي — شغّل `php artisan db:seed` أولاً"
          }
        },
        {
          "name": "Search Doctors (يحفظ doctor_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set('doctor_id', String(json.data[0].id));",
                  "    pm.test('doctor_id saved', () => pm.expect(json.data.length).to.be.above(0));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/doctors?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "doctors"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Doctor Schedule (يحفظ schedule_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.schedules && json.data.schedules.length > 0) {",
                  "    // schedule id من السيدر — نحتاج id من DB؛ استخدم المتغير من db:seed",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/doctors/{{doctor_id}}/schedule"
          }
        }
      ]
    },
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Send OTP (register)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"newpatient@example.com\",\n  \"type\": \"register\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/send-otp",
            "description": "type: register | login | password_reset"
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"newpatient@example.com\",\n  \"code\": \"123456\",\n  \"type\": \"register\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/verify-otp"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"مريض جديد\",\n  \"phone\": \"07709999111\",\n  \"email\": \"newpatient@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "بعد verify-otp — لا يرجع token، سجّل دخول بعدها"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.token) pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"07708888000\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Get My Profile (me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"مريض محدّث\",\n  \"birthdate\": \"1995-06-15\",\n  \"gender\": \"male\",\n  \"city\": \"بغداد\",\n  \"district\": \"الكرادة\",\n  \"address\": \"شارع الرشيد\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/profile"
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"newpassword456\",\n  \"new_password_confirmation\": \"newpassword456\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/password"
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "avatar", "type": "file", "src": "", "description": "JPG/PNG حتى 10MB" }
              ]
            },
            "url": "{{base_url}}/api/v1/auth/avatar"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"07708888000\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"07708888000\",\n  \"code\": \"123456\",\n  \"new_password\": \"password123\",\n  \"new_password_confirmation\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/reset-password"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "👨‍⚕️ Doctors",
      "item": [
        {
          "name": "Search Doctors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set('doctor_id', String(json.data[0].id));",
                  "    if (json.data[0].primary_branch) {",
                  "      pm.collectionVariables.set('branch_id', String(json.data[0].primary_branch.id));",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/doctors?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "doctors"],
              "query": [
                { "key": "speciality_id", "value": "", "disabled": true },
                { "key": "name", "value": "", "disabled": true },
                { "key": "governorate", "value": "بغداد", "disabled": true },
                { "key": "sort_by", "value": "rating", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Specialities",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/doctors/specialities"
          }
        },
