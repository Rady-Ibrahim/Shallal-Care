    {
      "name": "📅 Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.id) pm.collectionVariables.set('appointment_id', String(json.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"doctor_id\": {{doctor_id}},\n  \"schedule_id\": {{schedule_id}},\n  \"appointment_date\": \"2026-12-15\",\n  \"appointment_time\": \"10:00\",\n  \"notes\": \"زيارة أولى\"\n}"
            },
            "url": "{{base_url}}/api/v1/appointments",
            "description": "appointment_date يجب أن يكون في المستقبل — عدّل التاريخ"
          }
        },
        {
          "name": "My Appointments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.length > 0) {",
                  "    var completed = json.data.find(a => a.status === 'completed');",
                  "    if (completed) pm.collectionVariables.set('appointment_id', String(completed.id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/appointments/my",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "appointments", "my"],
              "query": [
                { "key": "status", "value": "", "disabled": true, "description": "pending | confirmed | completed | cancelled" }
              ]
            }
          }
        },
        {
          "name": "Get Appointment Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/appointments/{{appointment_id}}"
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/appointments/{{appointment_id}}/cancel",
            "description": "يعمل على المواعيد pending أو confirmed فقط"
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"appointment_date\": \"2026-12-20\",\n  \"appointment_time\": \"14:00\",\n  \"schedule_id\": {{schedule_id}}\n}"
            },
            "url": "{{base_url}}/api/v1/appointments/{{appointment_id}}/reschedule",
            "description": "يعمل على المواعيد pending فقط"
          }
        }
      ]
    },
