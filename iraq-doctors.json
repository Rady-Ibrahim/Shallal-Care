          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/doctors/featured?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "doctors", "featured"],
              "query": [
                { "key": "speciality_id", "value": "", "disabled": true },
                { "key": "governorate", "value": "بغداد", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
