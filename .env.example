APP_NAME="Shallal-Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_IQ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shallal-care-db 
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# جلسات منفصلة للأدمن والدكتور (نفس المتصفح — tab لكل لوحة)
ADMIN_SESSION_COOKIE=shallal_care_admin_session
DOCTOR_SESSION_COOKIE=shallal_care_doctor_session

# Shallal Tech — فوتر الروشتة والنظام
SHALLAL_TECH_PHONE=01000000000
SHALLAL_TECH_EMAIL=info@shallalcare.com
SHALLAL_TECH_WEBSITE=https://shallalcare.com
ONESIGNAL_ENABLED=false
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Mobile API — browse doctors/clinics only; booking is clinic reception (set BOOKING=true later)
MOBILE_API_ENABLED=true
MOBILE_DIRECTORY_ENABLED=true
MOBILE_GUEST_ENABLED=true
MOBILE_AUTH_ENABLED=true
MOBILE_BOOKING_ENABLED=false
MOBILE_REVIEWS_ENABLED=false
MOBILE_MEDICAL_HISTORY_ENABLED=false
MOBILE_PUSH_ENABLED=false
MOBILE_NEARBY_ENABLED=true

# أحجام الرفع (كيلوبايت — 10240 = 10 ميجا)
UPLOAD_MAX_IMAGE_KB=10240
UPLOAD_MAX_DOCUMENT_KB=10240

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
